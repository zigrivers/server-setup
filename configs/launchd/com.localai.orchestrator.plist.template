<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: replace __HOME__ with the absolute path of the user's home
     directory before installing into ~/Library/LaunchAgents/. The
     scripts/install-launchd-machine1.sh helper does this substitution
     for you. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.localai.orchestrator</string>
  <!-- 8-bit build since 2026-08-09: 38 GB instead of 65 GB, so a resident GLM-5.2 (390 GiB) fits
       alongside it on Machine 1. Keep METER_ORCH_REVIEW_MODEL in ~/ai/dashboard/dashboard.env
       pointed at the SAME path — a review spilled to M1 carrying the other id makes mlx load a
       second copy of the weights. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ORCH_MODEL_PATH</key><string>__HOME__/ai/models/orchestrator-qwen36-35b-a3b-heretic-mixed9</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/ai/local-ai-stack/scripts/start-orchestrator.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/ai/logs/orchestrator-launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/ai/logs/orchestrator-launchd.err</string>
</dict>
</plist>
