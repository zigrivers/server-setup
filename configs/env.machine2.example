# Machine 2 / inference worker
# Copy to ~/ai/local-ai-stack/.env and adjust paths as needed.
# NOTE: Replace /Users/admin with your actual macOS username (run: whoami).

# oMLX is the default server and loads ~/ai/models/developer-qwen38-27b-oq8e-mtp and
# ~/ai/models/reviewer-qwen38-27b-oq8e-mtp without any setting here (docs/OMLX.md).
# The two paths below are read only on the mlx_lm rollback path (LOCAL_AI_SERVER=mlx_lm).
DEV_MODEL_PATH=/Users/admin/ai/models/developer-qwen38-27b-8bit
REVIEW_MODEL_PATH=/Users/admin/ai/models/developer-qwen38-27b-8bit
WORKER_HOST=10.10.10.2
DEV_PORT=8002
REVIEW_PORT=8003
